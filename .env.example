# Local development only. Never use these credentials for staging or production.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/logistik_web"
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5432/logistik_web_test"

BETTER_AUTH_URL="http://localhost:3000"
# Generate a random secret locally, for example: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# Optional local-only administrator accounts: dev2_admin and dev3_admin.
# Set BOTH to distinct passwords (8-128 characters), then run npm run db:seed.
# Reruns preserve existing passwords, sessions, status and assignments.
DEV2_ADMIN_PASSWORD=""
DEV3_ADMIN_PASSWORD=""

# Baileys gateway implementing docs/decisions/WA-01-gateway-api.md.
# Server-only: never prefix with NEXT_PUBLIC_. Pairing requires an explicit connect/QR scan.
# HTTPS required; HTTP loopback is allowed only outside production.
WHATSAPP_GATEWAY_URL=""
# Random secret of at least 32 printable characters without spaces.
WHATSAPP_GATEWAY_API_KEY=""

# Proof-of-delivery photos (optional). Leave empty to disable photo upload.
# Server-only: never prefix with NEXT_PUBLIC_. Images are stored as WebP in
# the "lms/pod" folder. Values are on the Cloudinary dashboard (API Keys).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional local-only role accounts for testing access: demo_owner,
# demo_admin_jkt, demo_marketing, demo_kurir, demo_driver (BDG) and demo_jkt.
# Set one shared password (8-128 characters), then npm run db:seed:demo.
DEMO_BRANCH_PASSWORD=""

# Optional features built but not yet adopted. Set to "true" to enable.
# Scan AWB (/transactions/scan): status update by barcode/QR scan; also
# needs the "Scan AWB" right in Hak Akses Menu.
FEATURE_AWB_SCAN=""
