/// Retained legacy storage only; ignored by the generated client. No credential import.
/// DRAFT: rules TBD, D-04
model LegacyUser {
  deletedAt     DateTime?            @map("deleted_at")
  id            Int                  @id @default(autoincrement())
  name          String               @db.VarChar(100)
  username      String               @unique @db.VarChar(50)
  email         String               @unique @db.VarChar(100)
  /// DRAFT: hash algorithm and provider ownership TBD, D-04
  /// Secret: never return, log, import prototype passwords, or seed credentials.
  passwordHash  String?              @map("password_hash") @db.VarChar(255)
  role          String               @default("user") @db.VarChar(20)
  status        RecordStatus         @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  refreshTokens LegacyRefreshToken[]

  @@index([status])
  @@map("users")
  @@ignore
}

// Better Auth 1.6.23 core contract. Runtime activation is PLT-01.
// Auth storage uses native expiry/cleanup, not domain soft deletion.
model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  sessions      Session[]
  authAccounts  AuthAccount[]

  @@map("auth_users")
}

model Session {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime @map("expires_at")
  /// Secret: never expose or log.
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    Int       @id @default(autoincrement())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                Int       @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Secret fields: provider-owned values, never returned or logged.
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  /// Secret: provider verification material, never returned or logged.
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}

/// DRAFT: rules TBD, D-04
model LegacyRefreshToken {
  deletedAt DateTime?  @map("deleted_at")
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  user      LegacyUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash String     @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime   @map("expires_at")
  revokedAt DateTime?  @map("revoked_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@map("refresh_tokens")
  @@ignore
}
