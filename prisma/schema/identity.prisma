/// Prototype: models.User (user.go).
/// DRAFT: rules TBD, D-04
/// Auth provider remains undecided. Do not use in routes, actions, or UI.
model User {
  /// Prototype: ID.
  id            BigInt         @id @default(autoincrement())
  /// Prototype: Name.
  /// PII (D-25)
  name          String         @db.VarChar(100)
  /// Prototype: Username.
  /// PII (D-25)
  username      String         @unique @db.VarChar(50)
  /// Prototype: Email; Go value field normalized to required, proposed D-30.
  /// PII (D-25)
  email         String         @unique @db.VarChar(100)
  /// Prototype: Password; approved deviation: optional hash only, never plaintext.
  /// DRAFT: hash algorithm and provider ownership TBD, D-04
  /// Secret: never return, log, import prototype passwords, or seed credentials.
  passwordHash  String?        @map("password_hash") @db.VarChar(255)
  /// Prototype: Role; preserve string and observed default without inventing roles.
  role          String         @default("user") @db.VarChar(20)
  /// Prototype: IsActive (default:true).
  status        RecordStatus   @default(ACTIVE)
  /// Prototype: CreatedAt; retain timestamp semantics.
  createdAt     DateTime       @map("created_at")
  /// Prototype: UpdatedAt; retain timestamp semantics.
  updatedAt     DateTime       @map("updated_at")
  refreshTokens RefreshToken[]

  @@index([status])
  @@map("users")
}

/// Prototype: models.RefreshToken (user.go).
/// DRAFT: rules TBD, D-04
/// Prototype describes SHA-256 hashes; this is provenance, not an approved auth design.
/// No token issuance, refresh, or revocation behavior is implemented here.
model RefreshToken {
  /// Prototype: ID.
  id        BigInt    @id @default(autoincrement())
  /// Prototype: UserID.
  userId    BigInt    @map("user_id")
  /// Prototype: User (foreignKey:UserID).
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: TokenHash; secret hash storage only, never raw tokens or logs.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  /// Prototype: ExpiresAt; timestamp, not a calendar date.
  expiresAt DateTime  @map("expires_at")
  /// Prototype: RevokedAt; timestamp, not a calendar date.
  revokedAt DateTime? @map("revoked_at")
  /// Prototype: CreatedAt.
  createdAt DateTime  @map("created_at")
  /// Prototype: UpdatedAt.
  updatedAt DateTime  @map("updated_at")

  @@index([userId])
  @@map("refresh_tokens")
}
