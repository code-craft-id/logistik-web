/// Prototype: models.Account (account.go); chart-of-account master only.
/// DRAFT: rules TBD, D-13, D-14
/// No financial postings, classification checks, or reporting formulas are approved.
model Account {
  /// Prototype: ID.
  id                    BigInt              @id @default(autoincrement())
  /// Prototype: KodeRekening (uniqueIndex).
  accountCode           String              @unique @map("account_code") @db.VarChar(20)
  /// Prototype: InisialAkun.
  initials              String              @db.VarChar(50)
  /// Prototype: NamaRekening.
  name                  String              @db.VarChar(100)
  /// Prototype: IndukID.
  parentId              BigInt?             @map("parent_id")
  /// Prototype: Induk (foreignKey:IndukID).
  parent                Account?            @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: Children (foreignKey:IndukID).
  children              Account[]           @relation("AccountHierarchy")
  /// Prototype: LedgerID.
  ledgerId              BigInt              @map("ledger_id")
  /// Prototype: Ledger (foreignKey:LedgerID).
  ledger                Ledger              @relation(fields: [ledgerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: KategoriAkunID.
  accountCategoryId     BigInt              @map("account_category_id")
  /// Prototype: KategoriAkun (foreignKey:KategoriAkunID).
  accountCategory       AccountCategory     @relation(fields: [accountCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: Posisi; observed constants Neraca / Rugi Laba, retained as a string.
  position              String              @db.VarChar(20)
  /// Prototype: NormalBalance; observed constants Debet / Kredit.
  normalBalance         String              @map("normal_balance") @db.VarChar(10)
  /// Prototype: Tampil; observed constants Show / Hide, default Show.
  visibility            String              @default("Show") @db.VarChar(10)
  /// Prototype: JenisKategori; observed constants Parent / Child.
  categoryKind          String              @map("category_kind") @db.VarChar(20)
  /// Prototype: RugiLabaID.
  profitLossCategoryId  BigInt?             @map("profit_loss_category_id")
  /// Prototype: RugiLaba (foreignKey:RugiLabaID).
  profitLossCategory    ProfitLossCategory? @relation(fields: [profitLossCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: KategoriCashflowID.
  cashflowCategoryId    BigInt?             @map("cashflow_category_id")
  /// Prototype: KategoriCashflow (foreignKey:KategoriCashflowID).
  cashflowCategory      CashflowCategory?   @relation(fields: [cashflowCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: CabangID; null means Nasional in source comments, not an approved scope rule.
  accountingBranchId    BigInt?             @map("accounting_branch_id")
  /// Prototype: Cabang (*models.Branch, foreignKey:CabangID).
  accountingBranch      AccountingBranch?   @relation(fields: [accountingBranchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: Status (bool, default:true).
  status                RecordStatus        @default(ACTIVE)
  /// Prototype: CreatedAt.
  createdAt             DateTime            @map("created_at")
  /// Prototype: UpdatedAt.
  updatedAt             DateTime            @map("updated_at")
  vendorDebitSettings   VendorAccounting[]  @relation("VendorDebitAccount")
  vendorPayableSettings VendorAccounting[]  @relation("VendorPayableAccount")
  vendorRevenueSettings VendorAccounting[]  @relation("VendorRevenueAccount")

  @@index([parentId])
  @@index([ledgerId])
  @@index([accountCategoryId])
  @@index([profitLossCategoryId])
  @@index([cashflowCategoryId])
  @@index([accountingBranchId])
  @@index([status])
  @@map("accounts")
}

/// Prototype: models.Accounting (accounting.go); vendor accounting settings.
/// DRAFT: rules TBD, D-11, D-13
model VendorAccounting {
  /// Prototype: ID.
  id                     BigInt  @id @default(autoincrement())
  /// Prototype: VendorID (uniqueIndex); at most one settings row per vendor.
  vendorId               BigInt  @unique @map("vendor_id")
  vendor                 Vendor  @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: DebitAccountID.
  debitAccountId         BigInt  @map("debit_account_id")
  /// Prototype: DebitAccount (foreignKey:DebitAccountID).
  debitAccount           Account @relation("VendorDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: CreditHutangAccountID.
  creditPayableAccountId BigInt  @map("credit_payable_account_id")
  /// Prototype: CreditHutangAccount (foreignKey:CreditHutangAccountID).
  creditPayableAccount   Account @relation("VendorPayableAccount", fields: [creditPayableAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: CreditPendapatanAccountID.
  creditRevenueAccountId BigInt  @map("credit_revenue_account_id")
  /// Prototype: CreditPendapatanAccount (foreignKey:CreditPendapatanAccountID).
  creditRevenueAccount   Account @relation("VendorRevenueAccount", fields: [creditRevenueAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: BagiHasilPercent (float64, decimal(5,2), default:0).
  revenueSharePercent    Decimal @default(0) @map("revenue_share_percent") @db.Decimal(5, 2)
  /// Prototype: KomisiPercent (float64, decimal(5,2), default:0).
  commissionPercent      Decimal @default(0) @map("commission_percent") @db.Decimal(5, 2)

  @@index([debitAccountId])
  @@index([creditPayableAccountId])
  @@index([creditRevenueAccountId])
  @@map("vendor_accounting")
}

