/// Prototype: company.Company (company/company.go).
model Company {
  /// Prototype: CompanyID.
  id               BigInt    @id @default(autoincrement())
  /// Prototype: CompanyName.
  name             String    @map("name")
  /// Prototype: Address.
  /// PII (D-25)
  address          String?
  /// Prototype: City.
  /// PII (D-25)
  city             String?
  /// Prototype: PostalCode.
  /// PII (D-25)
  postalCode       String?   @map("postal_code")
  /// Prototype: PhoneNumber.
  /// PII (D-25)
  phoneNumber      String?   @map("phone_number")
  /// Prototype: FaxNumber.
  /// PII (D-25)
  faxNumber        String?   @map("fax_number")
  /// Prototype: DirectorName.
  /// PII (D-25)
  directorName     String?   @map("director_name")
  /// Prototype: TaxID.
  /// PII (D-25)
  taxId            String?   @map("tax_id")
  /// Prototype: Website.
  website          String?
  /// Prototype: Email.
  /// PII (D-25)
  email            String?
  /// Prototype: IsDepositAgent.
  isDepositAgent   Boolean   @map("is_deposit_agent")
  /// Prototype: ShowPriceOnPrint.
  showPriceOnPrint Boolean   @map("show_price_on_print")
  /// Prototype: Logo.
  logo             String?
  /// Prototype: BaseModel.CreatedAt.
  createdAt        DateTime  @default(now()) @map("created_at")
  /// Prototype: BaseModel.UpdatedAt.
  updatedAt        DateTime  @updatedAt @map("updated_at")
  /// Prototype: BaseModel.DeletedAt; soft deletion only.
  deletedAt        DateTime? @map("deleted_at")
  offices          Office[]

  @@map("companies")
}

/// Prototype: company.Office (company/office.go).
model Office {
  /// Prototype: OfficeID.
  id          BigInt       @id @default(autoincrement())
  /// Prototype: CompanyID.
  companyId   BigInt       @map("company_id")
  /// Prototype: OfficeCode.
  code        String
  /// Prototype: OfficeName.
  name        String
  /// Prototype: Address.
  /// PII (D-25)
  address     String?
  /// Prototype: City.
  /// PII (D-25)
  city        String?
  /// Prototype: PhoneNumber.
  /// PII (D-25)
  phoneNumber String?      @map("phone_number")
  /// Prototype: Email.
  /// PII (D-25)
  email       String?
  /// Prototype: OfficeManager.
  /// PII (D-25)
  managerName String?      @map("manager_name")
  /// Prototype: IsActive; no source default.
  status      RecordStatus
  /// Prototype: Company.
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: BaseModel.CreatedAt.
  createdAt   DateTime     @default(now()) @map("created_at")
  /// Prototype: BaseModel.UpdatedAt.
  updatedAt   DateTime     @updatedAt @map("updated_at")
  /// Prototype: BaseModel.DeletedAt; soft deletion only.
  deletedAt   DateTime?    @map("deleted_at")
  branches    Branch[]

  @@index([companyId])
  @@index([status])
  @@map("offices")
}

/// Prototype: company.Branch (company/branch.go); not models.Branch in account.go.
model Branch {
  /// Prototype: BranchID.
  id              BigInt            @id @default(autoincrement())
  /// Prototype: OfficeID.
  officeId        BigInt            @map("office_id")
  /// Prototype: BranchCode.
  code            String
  /// Prototype: BranchName.
  name            String
  /// Prototype: Address.
  /// PII (D-25)
  address         String?
  /// Prototype: City.
  /// PII (D-25)
  city            String?
  /// Prototype: PhoneNumber.
  /// PII (D-25)
  phoneNumber     String?           @map("phone_number")
  /// Prototype: BranchManager.
  /// PII (D-25)
  managerName     String?           @map("manager_name")
  /// Prototype: ManagerContact.
  /// PII (D-25)
  managerContact  String?           @map("manager_contact")
  /// Prototype: IsActive; no source default.
  status          RecordStatus
  /// Prototype: Office.
  office          Office            @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: BaseModel.CreatedAt.
  createdAt       DateTime          @default(now()) @map("created_at")
  /// Prototype: BaseModel.UpdatedAt.
  updatedAt       DateTime          @updatedAt @map("updated_at")
  /// Prototype: BaseModel.DeletedAt; soft deletion only.
  deletedAt       DateTime?         @map("deleted_at")
  agents          Agent[]
  drivers         Driver[]
  couriers        Courier[]
  vehicles        Vehicle[]
  marketingPeople MarketingPerson[]

  @@index([officeId])
  @@index([status])
  @@map("branches")
}

/// Prototype: models.Department (department.go).
/// DRAFT: rules TBD, D-24
/// Department versus division remains unconfirmed. Do not use in routes, actions, or UI.
model Department {
  /// Prototype: DepartmentID.
  id        BigInt       @id @default(autoincrement())
  /// Prototype: DepartmentCode.
  code      String
  /// Prototype: DepartmentName.
  name      String
  /// Prototype: IsActive; no source default.
  status    RecordStatus
  /// Prototype: BaseModel.CreatedAt.
  createdAt DateTime     @default(now()) @map("created_at")
  /// Prototype: BaseModel.UpdatedAt.
  updatedAt DateTime     @updatedAt @map("updated_at")
  /// Prototype: BaseModel.DeletedAt; soft deletion only.
  deletedAt DateTime?    @map("deleted_at")
  agents    Agent[]

  @@index([status])
  @@map("departments")
}

/// Prototype: company.Agent (company/agen.go).
model Agent {
  /// Prototype: AgentID.
  id             BigInt       @id @default(autoincrement())
  /// Prototype: BranchID.
  branchId       BigInt       @map("branch_id")
  /// Prototype: DepartmentID.
  departmentId   BigInt?      @map("department_id")
  /// Prototype: AgentCode.
  code           String
  /// Prototype: AgentInitials.
  initials       String
  /// Prototype: AgentName.
  name           String
  /// Prototype: AgentCategory; classification remains a string.
  category       String
  /// Prototype: PhoneNumber.
  /// PII (D-25)
  phoneNumber    String?      @map("phone_number")
  /// Prototype: AgentManager.
  /// PII (D-25)
  managerName    String?      @map("manager_name")
  /// Prototype: MobileNumber.
  /// PII (D-25)
  mobileNumber   String?      @map("mobile_number")
  /// Prototype: Balance (float64).
  /// DRAFT: currency, precision, and rounding TBD, D-11, D-24
  balance        Decimal      @db.Decimal(19, 2)
  /// Prototype: CommissionRate (float64).
  /// DRAFT: rate unit, precision, and rounding TBD, D-11
  commissionRate Decimal      @map("commission_rate") @db.Decimal(9, 4)
  /// Prototype: IsActive; no source default.
  status         RecordStatus
  /// Prototype: Branch.
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: Department; nullable because DepartmentID is a pointer.
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Prototype: BaseModel.CreatedAt.
  createdAt      DateTime     @default(now()) @map("created_at")
  /// Prototype: BaseModel.UpdatedAt.
  updatedAt      DateTime     @updatedAt @map("updated_at")
  /// Prototype: BaseModel.DeletedAt; soft deletion only.
  deletedAt      DateTime?    @map("deleted_at")

  @@index([branchId])
  @@index([departmentId])
  @@index([status])
  @@map("agents")
}
