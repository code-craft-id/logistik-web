/// SUP-01 ticket. Lifecycle Open/In Progress/Finish and requester approval
/// (Approve Finish / Revisi) follow the provider observation (D-35).
model Ticket {
  id             Int       @id @default(autoincrement())
  branchId       Int       @map("branch_id")
  createdById    Int       @map("created_by_id")
  subject        String    @db.VarChar(200)
  menuName       String    @map("menu_name") @db.VarChar(200)
  relatedPageUrl String    @map("related_page_url") @db.VarChar(2048)
  remarks        String?   @db.VarChar(5000)
  /// SQL CHECK tickets_priority_check enforces Low/Normal/High. No default.
  priority       String    @db.VarChar(10)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(64)
  status         String    @default("Open") @db.VarChar(20)
  approval       String?   @db.VarChar(20)
  approvalNote   String?   @map("approval_note") @db.VarChar(1000)
  approvedById   Int?      @map("approved_by_id")
  approvedAt     DateTime? @map("approved_at")
  approvedBy     User?     @relation("TicketApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User      @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  messages TicketMessage[]

  @@unique([createdById, idempotencyKey])
  @@index([createdById, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status])
  @@map("tickets")
}

/// Chat on a ticket (provider ticket detail, OBSERVED 2026-11-27). Append-only.
model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authorId  Int      @map("author_id")
  author    User     @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId, id])
  @@map("ticket_messages")
}
