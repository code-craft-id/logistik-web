  createdAt        DateTime          @default(now()) @map("created_at")
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(100)
  /// DRAFT: legacy text (2026-10-25), D-26. OBSERVED 2026-11-19 and owner-approved for the Dimensi volume only (P x L x T cm / divider), pending Dev 2 review; non-numeric or zero disables it.
  divider          String            @db.VarChar(100)
  status           RecordStatus      @default(ACTIVE)
  deliveryServices DeliveryService[]
  transactions     Transaction[]

  @@index([status])
  @@map("transport_modes")
}

