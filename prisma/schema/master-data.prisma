/// Service dictionary only; this is not an operational delivery model.
model DeliveryService {
  deletedAt         DateTime?        @map("deleted_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  id                Int              @id @default(autoincrement())
  name              String           @db.VarChar(100)
  serviceCategoryId Int?             @map("service_category_id")
  serviceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transportModeId   Int?             @map("transport_mode_id")
  transportMode     TransportMode?   @relation(fields: [transportModeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status            RecordStatus     @default(ACTIVE)

  @@index([serviceCategoryId])
  @@index([transportModeId])
  @@index([status])
  @@map("delivery_services")
}

