model Vehicle {
  deletedAt              DateTime?     @map("deleted_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  id                     Int           @id @default(autoincrement())
  name                   String        @db.VarChar(100)
  truckingTypeId         Int?          @map("trucking_type_id")
  truckingType           TruckingType? @relation(fields: [truckingTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  year                   Int
  licensePlate           String        @map("license_plate") @db.VarChar(20)
  registrationHolderName String        @map("registration_holder_name") @db.VarChar(100)
  registrationNumber     String        @map("registration_number") @db.VarChar(50)
  registrationDate       DateTime?     @map("registration_date") @db.Date
  cylinderCapacity       String        @map("cylinder_capacity") @db.VarChar(50)
  color                  String        @db.VarChar(50)
  insuranceName          String        @map("insurance_name") @db.VarChar(100)
  insuranceExpiry        DateTime?     @map("insurance_expiry") @db.Date
  description            String
  chassisNumber          String        @map("chassis_number") @db.VarChar(100)
  engineNumber           String        @map("engine_number") @db.VarChar(100)
  status                 RecordStatus  @default(ACTIVE)
  serviceTrucking        Boolean       @default(false) @map("service_trucking")
  branchId               Int?          @map("branch_id")
  branch                 Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  manifests              Manifest[]

  @@index([truckingTypeId])
  @@index([branchId])
  @@index([status])
  @@map("vehicles")
}

