model Driver {
  deliverySheets      DeliverySheet[]
  podReturns          PodReturn[]
  deletedAt           DateTime?       @map("deleted_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  id                  Int             @id @default(autoincrement())
  name                String          @db.VarChar(100)
  address             String
  nationalIdNumber    String          @map("national_id_number") @db.VarChar(20)
  driverLicenseNumber String          @map("driver_license_number") @db.VarChar(20)
  phone               String          @db.VarChar(20)
  branchId            Int?            @map("branch_id")
  branch              Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status              RecordStatus    @default(ACTIVE)

  @@index([branchId])
  @@index([status])
  @@map("drivers")
}

model Courier {
  deliverySheets     DeliverySheet[]
  bookings           Booking[]       @relation("BookingCourier")
  pickupTransactions Transaction[]   @relation("TransactionPickupCourier")
  deletedAt          DateTime?       @map("deleted_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  id                 Int             @id @default(autoincrement())
  name               String          @db.VarChar(100)
  address            String
  nationalIdNumber   String          @map("national_id_number") @db.VarChar(20)
  phone              String          @db.VarChar(20)
  branchId           Int?            @map("branch_id")
  branch             Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status             RecordStatus    @default(ACTIVE)
  transactions       Transaction[]
  manifests          Manifest[]

  @@index([branchId])
  @@index([status])
  @@map("couriers")
}

model TransportMode {
  bookings         Booking[]         @relation("BookingTransportMode")
